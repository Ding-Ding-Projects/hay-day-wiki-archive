g alt=\"Lemon candle\" loading=\"lazy\" width=\"75\" height=\"75\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n</td></tr>\n<tr>\n<td><b><a href=\"/wiki/tomato-sauce-19456\" title=\"Tomato Sauce\" rel=\"noopener noreferrer\" target=\"_blank\">Tomato Sauce</a></b>\n</td>\n<td><b><a href=\"/wiki/blueberry-chutney-36331\" title=\"Blueberry Chutney\" rel=\"noopener noreferrer\" target=\"_blank\">Blueberry Chutney</a></b>\n</td>\n<td><b><a href=\"/wiki/lemon-candle-16477\" title=\"Lemon Candle\" rel=\"noopener noreferrer\" target=\"_blank\">Lemon Candle</a></b>\n</td></tr>\n<tr>\n<td><span><a href=\"https://static.wikia.nocookie.net/hayday/images/3/35/Lemon.png/revision/latest?cb=20240219033200\" class=\"mw-file-description image\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Lemon\" loading=\"lazy\" width=\"50\" height=\"50\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><b>x1</b>\n</td>\n<td><span><a href=\"https://static.wikia.nocookie.net/hayday/images/3/35/Lemon.png/revision/latest?cb=20240219033200\" class=\"mw-file-description image\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Lemon\" loading=\"lazy\" width=\"50\" height=\"50\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><b>x1</b>\n</td>\n<td><span><a href=\"https://static.wikia.nocookie.net/hayday/images/3/35/Lemon.png/revision/latest?cb=20240219033200\" class=\"mw-file-description image\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Lemon\" loading=\"lazy\" width=\"50\" height=\"50\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><b>x2</b>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/experience-19023\" title=\"Experience\" rel=\"noopener noreferrer\" target=\"_blank\">Level</a> 69\n</td>\n<td><a href=\"/wiki/experience-19023\" title=\"Experience\" rel=\"noopener noreferrer\" target=\"_blank\">Level</a> 70\n</td>\n<td><a href=\"/wiki/experience-19023\" title=\"Experience\" rel=\"noopener noreferrer\" target=\"_