"_blank\"><img alt=\"Blue Peacock\" src=\"https://static.wikia.nocookie.net/hayday/images/c/c0/Blue_Peacock.png/revision/latest/scale-to-width-down/35?cb=20211021181731\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element\" loading=\"lazy\"></a></span><span><a href=\"/wiki/brown-peacock-35257\" title=\"Brown Peacock\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Brown Peacock\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/white-peacock-35403\" title=\"White Peacock\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"White Peacock\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/plate-billed-mountain-toucan-35405\" title=\"Plate-billed Mountain Toucan\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Plate-billed Mountain Toucan\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/keel-billed-toucan-35407\" title=\"Keel-billed Toucan\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Keel-billed Toucan\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/toco-toucan-35579\" title=\"Toco Toucan\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Toco Toucan\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/major-mitchell-s-cockatoo-35580\" title=\"Major Mitchell&amp;#39;s Cockatoo\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Major Mitchell&amp;#39;s Cockatoo\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/sulphur-crested-cockatoo-35582\" title=\"Sulphur Crested Cockatoo\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Sulphur Crested Cockatoo\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/rose-breasted-cockatoo-35627\" title=\"Rose-Breasted Cockatoo\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Rose-Breasted Cockatoo\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/dalmatian-pelican-35829\" title=\"Dalmatian Pelican\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Dalmatian Pelican\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/brown-pelican-35828\" title=\"Brown Pelican\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Brown Pelican\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/australian-pelican-35824\" title=\"Australian Pelican\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Australian Pelican\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/capped-heron-35830\" title=\"Capped Heron\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Capped Heron\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/tricolored-heron-35831\" title=\"Tricolored Heron\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Tricolored Heron\" loading=\"lazy\" width=\"35\" height=\"77\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/agami-heron-35866\" title=\"Agami Heron\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Agami Heron\" loading=\"lazy\" width=\"35\" height=\"45\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/andean-flamingo-36051\" title=\"Andean Flamingo\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Andean Flamingo\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/american-flamingo-36078\" title=\"American Flamingo\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"American Flamingo\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/greater-flamingo-36140\" title=\"Greater Flamingo\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Greater Flamingo\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/black-swan-36279\" title=\"Black Swan\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Black Swan\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/black-necked-swan-36281\" title=\"Black-necked Swan\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Black-necked Swan\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/whooper-swan-36282\" title=\"Whooper Swan\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Whooper Swan\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><br><span><a href=\"/wiki/scarlet-macaw-36460\" title=\"Scarlet Macaw\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Scarlet Macaw\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/hyacinth-macaw-36463\" title=\"Hyacinth Macaw\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Hyacinth Macaw\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span><span><a href=\"/wiki/blue-and-gold-macaw-36466\" title=\"Blue-and-Gold Macaw\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Blue-and-Gold Macaw\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span></div>\n</div>\n\n</section>\n\n\n<p class=\"mw-empty-elt\"></p><p><br>\n<b>Bird houses</b> is a shelter for different types of birds. It is unlocked at <a href=\"/wiki/experience-19023\" title=\"Experience\" rel=\"noopener noreferrer\" target=\"_blank\">experience</a> level 20.\n</p>\n<div></div>\n<hr>\n<h3><span class=\"mw-headline\"><b>Appearance</b></span></h3>\n<figure class=\"thumb mw-halign-left show-info-icon\"> \t<a href=\"https://static.wikia.nocookie.net/hayday/images/1/1f/Bird_house_left.gif/revision/latest?cb=20211025055033\" class=\"mw-file-description image\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Bird house left\" loading=\"lazy\" width=\"100\" height=\"138\" class=\"thumbimage lazyload\" loading=\"lazy\"></a> \t<a href=\"https://static.wikia.nocookie.net/hayday/images/1/1f/Bird_house_left.gif/revision/latest?cb=20211025055033\" class=\"mw-file-description image\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Bird house left\" src=\"https://static.wikia.nocookie.net/hayday/images/1/1f/Bird_house_left.gif/revision/latest/scale-to-width-down/100?cb=20211025055033\" loading=\"lazy\" width=\"100\" height=\"138\" class=\"thumbimage\" loading=\"lazy\"></a> \t<figcaption class=\"thumbcaption\"> \t\t \t\t\t<a href=\"/unavailable-source?media=File%3ABird_house_left.gif\" class=\"info-icon\" rel=\"noopener noreferrer\" target=\"_blank\"></a> \t\t \t\t \t\t \t</figcaption> </figure>\n<p>The house is a pink gazebo with a watering trough.\n</p>\n<div></div>\n<hr>\n<h3><span class=\"mw-headline\"><b>Building</b></span></h3>\n<p>The house costs 10,000 <span>coin</span><span title=\"Coin(s)\"><span class=\"mw-default-size\"><span title=\"coin\"><img alt=\"coin\" loading=\"lazy\" width=\"25\" height=\"25\" class=\"mw-file-element lazyload\" loading=\"lazy\"></span></span></span> and can hold up to 15 birds. Building it takes no time and the bucket capacity is able to hold up to 20 feeds.\n</p>\n<hr>\n<table class=\"navbox mw-collapsible mw-collapsed\">\n\n<tbody><tr class=\"navtitle\">\n<td><a href=\"/wiki/category%2Fcategory-animal-shelters-6565\" title=\"Category:Animal Shelters\" rel=\"noopener noreferrer\" target=\"_blank\">Animal Shelters</a>\n</td></tr>\n<tr>\n<td>\n<p><span><a href=\"/wiki/alpaca-house-36823\" title=\"Alpaca House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Alpaca House\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/beehive-tree-15804\" title=\"Beehive Tree\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Beehive Tree Stage 4\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/bird-house-35210\" title=\"Bird House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Bird House\" loading=\"lazy\" width=\"100\" height=\"142\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/bunny-house-12523\" title=\"Bunny House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Bunny House\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/cat-house-2711\" title=\"Cat House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Cat House\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/chicken-coop-2715\" title=\"Chicken Coop\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Chicken Coop\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/cow-pasture-2717\" title=\"Cow Pasture\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Cow Pasture\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/dog-house-2713\" title=\"Dog House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Dog House\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/donkey-stable-9426\" title=\"Donkey Stable\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Donkey Stable\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/goat-yard-2723\" title=\"Goat Yard\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Goat Yard\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/guinea-pig-house-35051\" title=\"Guinea Pig House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Guinea Pig House\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/horse-stable-2709\" title=\"Horse Stable\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Horse Stable\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/kitten-house-18341\" title=\"Kitten House\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Kitten House\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/lamb-pasture-36754\" title=\"Lamb Pasture\" rel=\"noopener noreferrer\" target=\"_blank\"><img alt=\"Lamb Pasture\" loading=\"lazy\" width=\"100\" height=\"58\" class=\"mw-file-element lazyload\" loading=\"lazy\"></a></span>\n<span><a href=\"/wiki/pig-pen-2719\" title=\"Pig Pen\"