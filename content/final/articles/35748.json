tps://static.wikia.nocookie.net/hayday/images/d/d3/Cherry_Tree.png/revision/latest/scale-to-width-down/50?cb=20191028173301\" title=\"Cherry Tree (99 KB)\" class=\"thumbimage\" alt=\"\" height=\"50\" width=\"50\" loading=\"lazy\"><img title=\"Cherry Tree (99 KB)\" class=\"thumbimage lazyload\" alt=\"\" height=\"50\" width=\"50\" loading=\"lazy\"></a></div></div></div><div class=\"wikia-gallery-item\"><div class=\"thumb\"><div class=\"gallery-image-wrapper\"><a class=\"image link-internal\" href=\"/wiki/cacao-tree-2607\" title=\"Cacao Tree (54 KB)\" rel=\"noopener noreferrer\" target=\"_blank\"><img src=\"https://static.wikia.nocookie.net/hayday/images/a/a4/Cacao_Tree.png/revision/latest/scale-to-width-down/50?cb=20191028181018\" title=\"Cacao Tree (54 KB)\" class=\"thumbimage\" alt=\"\" height=\"50\" width=\"50\" loading=\"lazy\"><img title=\"Cacao Tree (54 KB)\" class=\"thumbimage lazyload\" alt=\"\" height=\"50\" width=\"50\" loading=\"lazy\"></a></div></div></div><div class=\"wikia-gallery-item\"><div class=\"thumb\"><div class=\"gallery-image-wrapper\"><a class=\"image link-internal\" href=\"/wiki/coconut-tree-35591\" title=\"Coconut Tree (278 KB)\" rel=\"noopener noreferrer\" target=\"_blank\"><img src=\"https://static.wikia.nocookie.net/hayday/images/4/41/Coconut_Tree.png/revision/latest/scale-to-width-down/31?cb=20260401002151\" title=\"Coconut Tree (278 KB)\" class=\"thumbimage\" alt=\"\" height=\"50\" width=\"50\" loading=\"lazy\"><img title=\"Coconut Tree (278 KB)\" class=\"thumbimage lazyload\" alt=\"\" height=\"50\" width=\"50\" loading=\"lazy\"></a></div></div></div><div class=\"wikia-gallery-item\"><div class=\"thumb\"><div class=\"gallery-image-wrapper\"><a class=\"image link-internal\" href=\"/wiki/coffee-bush-2613\" title=\"Coffee Bush (307 KB)\" rel=\"noopener noreferrer\" target=\"_blank\"><img src=\"https://static.wikia.nocookie.net/hayday/images/5/5f/Coffee_Bush.png/revision/latest/scale-to-width-down/50?cb=20180217161619\" title=\"Coffee Bush (