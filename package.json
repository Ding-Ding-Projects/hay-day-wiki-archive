{
  "name": "hay-day-wiki-archive",
  "version": "0.1.0",
  "private": true,
  "description": "An offline, attributed reader for the archived Hay Day Wiki snapshot.",
  "author": "Ding Ding Projects",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:check": "node scripts/check-pages-output.mjs",
    "desktop:icon": "node scripts/generate-icon.mjs",
    "desktop:dir": "npm run desktop:icon && electron-builder --win dir --publish never",
    "desktop:package": "electron-builder --win squirrel --publish never",
    "desktop:verify": "node scripts/verify-desktop-package.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "import": "node scripts/import-wiki.mjs",
    "test:wiki": "node --test test/wiki-importer.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.8",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.dingdingprojects.haydaywikiarchive",
    "productName": "Hay Day Wiki Archive",
    "artifactName": "Hay-Day-Wiki-Archive-${version}.${ext}",
    "directories": {
      "output": "dist/installer",
      "buildResources": "desktop"
    },
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/installer/**",
      "!dist/server/**",
      "!dist/client/**",
      "!dist/.vite/**",
      "!content/**",
      "!app/**",
      "!components/**",
      "!lib/**",
      "!scripts/**",
      "!test/**",
      "!docs/**",
      "!public/**",
      "!*.md",
      "!*.bat",
      "!*.json",
      "package.json",
      "desktop/**/*",
      "dist/pages/**/*"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [{ "target": "squirrel", "arch": ["x64"] }],
      "icon": "desktop/icon.ico",
      "signExecutable": false,
      "signAndEditExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "Hay-Day-Wiki-Archive-${version}-Setup.${ext}",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/hay-day-wiki-archive/main/desktop/icon.ico",
      "remoteReleases": false
    }
  }
}
